# Copy to .env and fill locally. Never commit .env.
# ClawShield references these by NAME in config/clawshield.yaml.

# Slack incoming webhook for regression alerts (optional)
CLAWSHIELD_SLACK_WEBHOOK=

# Only needed for the openai_compat target (optional)
CLAWSHIELD_TARGET_API_KEY=

# DefenseClaw's own keys live in ~/.defenseclaw/.env via `defenseclaw keys set ...`.
# Do not duplicate them here.



